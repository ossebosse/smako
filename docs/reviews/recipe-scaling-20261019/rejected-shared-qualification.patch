+    def _qualify_single(self, meal, recipe):
+        """One-recipe basket and variant evidence, reused from an identical request.
+
+        The shared scope digests the whole request and private state (see
+        planner_shared_cache), and the key is the exact cleaned recipe value.
+        Traced product events of the original calculation are replayed, so the
+        decision trace equals a fresh calculation. Failures are never shared.
+        """
+        from app.services.planner_shared_cache import SHARED_QUALIFICATION, qualification_scope
+        if not hasattr(self, "_qualification_scope"):
+            self._qualification_scope = qualification_scope(self)
+        scope = self._qualification_scope
+        key = (meal.meal_type, self.recipe_computations.key(recipe))
+        shared = SHARED_QUALIFICATION.get(scope, key) if scope is not None else None
+        if shared is not None:
+            qualified, evidence, events = shared
+            for args, kwargs in events:
+                self.product_trace.event(*args, **kwargs)
+            return qualified, evidence
+        events = []
+        trace_event = self.product_trace.event
+
+        def recorded(*args, **kwargs):
+            events.append((args, kwargs))
+            return trace_event(*args, **kwargs)
+
+        self.product_trace.event = recorded
+        try:
+            slot = MealSlot(id=f"{meal.meal_type}-1", day=1, meal_type=meal.meal_type, recipe=recipe)
+            qualified = self.basket([slot], final=False)
+            evidence = None
+            if recipe.design:
+                from app.services.stable_candidate_pool import VariantSearchEvidence
+                items = [i for s in qualified["basket"].stores for i in s.items]
+                nutrition = self._check_nutrition(
+                    [MealSlot(id=f"{meal.meal_type}-1", day=1, meal_type=meal.meal_type, recipe=recipe)],
+                    {i.ingredient: i for i in items}, qualified["trace_inputs"][1], qualified["allocations"])
+                evidence = VariantSearchEvidence(qualified["basket"].total,
+                    tuple(sorted(nutrition[0]["values"].items())),
+                    frozenset((i.store_id, i.product_id) for i in items))
+        finally:
+            del self.product_trace.event  # restore the class method
+        if scope is not None:
+            SHARED_QUALIFICATION.put(scope, key, (qualified, evidence, tuple(events)))
+        return qualified, evidence
+
