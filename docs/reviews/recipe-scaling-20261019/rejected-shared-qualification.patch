+# --- Single-recipe qualification -------------------------------------------
+# A qualification basket depends on the whole request, private state included
+# (pantry, consumed demands, locks, extras, limits, store cap, clock). Its scope
+# is the resolution scope plus a digest of ALL of those inputs, so only an
+# identical request reuses it: e.g. the same profile and stores asked again.
+SHARED_QUALIFICATION = SharedResolution(scope_limit=2, entry_limit=4096)
+
+
+def qualification_enabled() -> bool:
+    return enabled() and os.getenv("SMAKO_PLANNER_SHARED_QUALIFICATION", "1") != "0"
+
+
+def request_digest(planner):
+    import hashlib
+    import json
+
+    payload = {
+        "request": planner.request.model_dump(mode="json"),
+        "state": planner.state, "plan_id": planner.plan_id,
+        "cooked_weights": planner.cooked_weights,
+        "now": planner.now.isoformat(), "complete": planner.complete,
+        "nutrition_search_limit": planner.nutrition_search_limit,
+        "include_content_pack": planner.include_content_pack,
+        "library_generation": planner.library_generation, "generation": planner._generation,
+    }
+    encoded = json.dumps(payload, sort_keys=True, default=repr, ensure_ascii=False).encode()
+    return hashlib.sha256(encoded).hexdigest()
+
+
+def qualification_scope(planner):
+    if not qualification_enabled():
+        return None
+    return SHARED_QUALIFICATION.scope((*scope_key(planner), request_digest(planner)), planner.prepared)
