+def test_price_led_completion_crosses_a_package_affinity_local_minimum(monkeypatch):
+    from app.services import plan_jobs
+
+    groups = options([f'{i:02d}' for i in range(65)], days=3)
+    remaining, calls = [30.0], []
+    monkeypatch.setattr(plan_jobs, 'remaining_planning_seconds', lambda: remaining[0])
+
+    def priority(slot):
+        preferred = {1: ['00'], 2: ['01', '03'], 3: ['02', '04']}[slot.day]
+        return preferred.index(slot.recipe.name) if slot.recipe.name in preferred else 10+int(slot.recipe.name)
+
+    def evaluate(slots, final):
+        assert final
+        names = tuple(s.recipe.name for s in slots)
+        calls.append(names)
+        if len(calls) == 3:
+            remaining[0] = 11
+        return {('00', '03', '04'): 100, ('00', '01', '02'): 50}.get(names, 150)
+
+    chosen, cost = MenuOptimizer().optimize_slots(groups, complete_first=True,
+        accepts=lambda slots, final: len({s.recipe.name for s in slots}) == len(slots),
+        evaluate=evaluate, score=lambda slots, value: value, candidate_priority=priority,
+        candidate_packages=lambda s: {'shared'} if s.recipe.name in {'00', '03', '04'} else {s.recipe.name})
+    # Both cheaper replacements are needed; either single change costs 150.
+    assert calls[:2] == [('00', '03', '04'), ('00', '01', '02')]
+    assert cost == 50 and tuple(s.recipe.name for s in chosen) == ('00', '01', '02')
