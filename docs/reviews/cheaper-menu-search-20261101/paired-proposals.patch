+@pytest.mark.parametrize('barrier', ['packages', 'distribution'])
+def test_broad_joint_moves_cross_a_single_replacement_barrier(monkeypatch, barrier):
+    from app.services import plan_jobs
+
+    groups = options([f'{i:02d}' for i in range(17)], days=3)
+    remaining = [30.0]
+    monkeypatch.setattr(plan_jobs, 'remaining_planning_seconds', lambda: remaining[0])
+    calls, trace = [], []
+    target = ('00', '01', '01')
+
+    def accepts(slots, final):
+        # Two meal categories must be changed together to retain distribution.
+        return (barrier != 'distribution' or not final
+                or slots[1].recipe.name == slots[2].recipe.name)
+
+    def evaluate(slots, final):
+        assert final and accepts(slots, final)
+        names = tuple(s.recipe.name for s in slots)
+        calls.append(names)
+        if len(calls) == 40:
+            remaining[0] = 11
+        # Sharing a package only pays off after BOTH replacements. A singleton
+        # price, or either single replacement's cost, cannot prove the saving.
+        return 50 if names == target else 100 if names == ('00', '00', '00') else 150
+
+    chosen, cost = MenuOptimizer().optimize_slots(groups, complete_first=True,
+        accepts=accepts, evaluate=evaluate, score=lambda slots, value: value,
+        candidate_priority=lambda slot: slot.recipe.name, search_trace=trace)
+    assert cost == 50 and tuple(s.recipe.name for s in chosen) == target
+    assert trace[-1]['joint_improvements'] >= 1
+    assert not trace[-1].get('proposal_space_enumerated')
+    assert trace[-1]['finalization_reserve_seconds'] == 12
+
