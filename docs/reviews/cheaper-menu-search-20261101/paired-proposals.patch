+def test_joint_checkout_failure_preserves_the_verified_search_incumbent(monkeypatch):
+    from app.services import plan_jobs
+
+    remaining, calls, trace = [30.0], [], []
+    monkeypatch.setattr(plan_jobs, 'remaining_planning_seconds', lambda: remaining[0])
+
+    def evaluate(slots, final):
+        names = tuple(s.recipe.name for s in slots)
+        calls.append(names)
+        if len(calls) == 30:
+            remaining[0] = 11
+        if sum(n != '00' for n in names) >= 2:
+            raise ValueError('Joint quantity, nutrition or organic qualification failed')
+        return 100 if names == ('00', '00', '00') else 150
+
+    chosen, cost = MenuOptimizer().optimize_slots(
+        options([f'{i:02d}' for i in range(17)], days=3), complete_first=True,
+        accepts=lambda slots, final: True, evaluate=evaluate,
+        score=lambda slots, value: value, search_trace=trace)
+    assert cost == 100 and all(s.recipe.name == '00' for s in chosen)
+    assert trace[-1]['joint_evaluations'] > 0
+    assert trace[-1]['evaluation_rejected'] > 0
+    assert trace[-1]['joint_improvements'] == 0
