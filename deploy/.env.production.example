# Copy to deploy/.env.production and keep that file outside version control.
APP_ENV=production
APP_VERSION=0.1.0-beta.1
BUILD_ID=replace-with-immutable-git-or-release-id
# Host-only Compose bind root. Relative paths resolve beside compose.yaml;
# use an absolute path such as D:/codex-rc/runtime for an isolated rehearsal.
RUNTIME_ROOT=./runtime

# A real DNS name pointing to the server. Caddy obtains and renews TLS.
PUBLIC_BASE_URL=https://beta.example.se
ACME_EMAIL=operations@example.se

# The small beta deliberately uses one Uvicorn worker and durable SQLite files.
GROCERY_DATABASE_URL=sqlite+pysqlite:////srv/app/var/grocery/grocery_data.sqlite?timeout=30
PLAN_STORE_PATH=/srv/app/var/plans/consumer_plans.sqlite3
GROCERY_RAW_SNAPSHOT_ROOT=/srv/app/var/raw_snapshots
PRICE_UNIVERSE_CACHE_ROOT=/srv/app/var/price_universes
PRICE_UNIVERSE_REQUIRED=true
PRICE_UNIVERSE_CITY=Lund

# Independent minimum-32-byte values. SECRET_KEY pseudonymizes anonymous beta
# sessions; BETA_ADMIN_TOKEN protects admin/status and runtime reload. Never
# reuse a retailer/provider credential for either value.
SECRET_KEY=replace-with-at-least-32-random-bytes
BETA_ADMIN_TOKEN=replace-with-a-different-32-byte-value

# Existing approved licensed-source refresh. Leave no real key in this file in
# source control. Docker Compose injects the uncommitted production value.
PRIMAT_API_KEY=
PRIMAT_BASE_URL=https://primat.nu/api/v3

# Existing production policies; no live provider calls occur during planning.
PRICE_PROVIDER=auto
MEAL_PLAN_STRATEGY=optimized
MAX_PRICE_AGE_HOURS=48
PRICE_AGE_WARNING_HOURS=36
ALLOW_PROVIDER_FALLBACK=false
ALLOW_MOCK_FALLBACK=false
OWN_SOURCES_ONLY=false
STABLE_CANDIDATE_SEARCH_ENABLED=true
STABLE_CANDIDATE_BASE_COUNT=120
STABLE_CANDIDATE_SEARCH_LIMIT=160

# One CPU-heavy planner at a time, with a bounded beta burst queue. Requests
# beyond the four waiters fail quickly with Retry-After instead of timing out.
PLANNER_MAX_CONCURRENT_REQUESTS=1
PLANNER_MAX_QUEUED_REQUESTS=4

# Self-service privacy erasure is intentionally much more tightly rate-limited
# than normal product telemetry.
PRIVACY_ERASURE_RATE_LIMIT_REQUESTS=3
PRIVACY_ERASURE_RATE_LIMIT_WINDOW_SECONDS=3600
PRIVACY_ERASURE_NETWORK_RATE_LIMIT_REQUESTS=20

# Community evidence and raw receipt policy.
COMMUNITY_EVIDENCE_MAX_REPORTS_PER_HOUR=60
COMMUNITY_EVIDENCE_DUPLICATE_WINDOW_HOURS=1
COMMUNITY_RECEIPT_RAW_RETENTION_HOURS=0

# External cron container. Times are Europe/Stockholm through TZ above.
DAILY_REFRESH_CRON=17 03 * * *
DAILY_REFRESH_SCHEDULE=03:17 Europe/Stockholm
# One bounded source-level recovery check three hours after the normal run.
COOP_RETRY_CRON=17 06 * * *
COOP_RETRY_SCHEDULE=06:17 Europe/Stockholm
DAILY_BACKUP_CRON=47 02 * * *
REFRESH_CITY=Lund
REFRESH_POSTAL_CODE=22350
REFRESH_REPORT_DIR=/srv/app/var/reports/refresh
REFRESH_TIMEOUT_SECONDS=7200
SOURCE_RETRY_STATUS_PATH=/srv/app/var/reports/operations/source-retry-status.json
BACKUP_ROOT=/srv/app/var/backups
BACKUP_RETENTION_DAYS=14
INTERNAL_APP_BASE_URL=http://app:8000

# REVIEW-gated OWN collectors use only the exact registry-verified contexts.
# Coop 730400 is Coop Online Syd (ONLINE_FULFILLMENT/online_price), never a
# physical Coop store or verified shelf-price context. Do not broaden either
# allowlist without separately verified registry/source evidence.
HEMKOP_ALLOW_FULL_CRAWL=true
HEMKOP_STORE_EXTERNAL_IDS=4123,4224
COOP_ALLOW_FULL_CRAWL=true
COOP_ONLINE_CONTEXT_IDS=730400

# Keep backups running when a source job is temporarily blocked.
DAILY_REFRESH_ENABLED=true
COOP_RETRY_ENABLED=true

# Full hypothetical menu prewarming occupies the single planner slot and made
# the first real user wait ~7.5 min after a restart (reports/startup-wait-20261016.md).
# Keep it off; shared product facts are loaded separately in the background.
PRICE_UNIVERSE_PREWARM_ENABLED=false
SOURCE_FACTS_PREWARM_ENABLED=true
# Recipes per meal type in the library seed search (0 = all). Refinement still
# uses the whole qualified library; 40 gave identical menus and ~20 % shorter
# planning in reports/recipe-packs-20261017/README.md.
LIBRARY_SEED_POOL_LIMIT=40
# Recipes per meal type in the single-swap refinement (0 = all). 90 gave
# identical menus in ten matrix profiles; 60 made the protein-distribution
# profile 5,15 kr dearer (docs/HANDOFF.md, 2026-10-17).
LIBRARY_REFINEMENT_POOL_LIMIT=90
# Recipes per meal type from each newer library generation that the
# substitution sweep tries in every slot (0 = all, the former behaviour).
# Heuristic: measured against the full-library reference in
# docs/reviews/recipe-scaling-20261019.md before relying on it.
LIBRARY_SUBSTITUTION_POOL_LIMIT=40
