        "termometer"
      ],
      "family": "nam prik ong",
      "flavor": [
        "tomat",
        "torkad chili",
        "fisksås"
      ],
      "meal_type": "dinner",
      "method": "pot",
      "name": "Nam prik ong – tomat- och fläskdipp med grönsaker – enkel – fisksåsversion utan räkpasta",
      "notes": "Granskad fisksåsversion: 15 g räkpasta utgår. Enkel använder 20 ml fisksås; övriga använder totalt 30 ml i stället för tidigare 20 ml plus räkpastan. Detta är nya doser, inte likvärdig sälta eller fermenterad smak. Såsen innehåller fortfarande fisk. Inte provlagad. Innehållsgranskad 2026-11-01 med angiven produktform och mängdenhet; inte provlagad. Mängdändringar redovisas i granskningsrapporten.",
      "primary": "fläskfärs",
      "servings": 4,
      "side": "ris och råa grönsaker",
      "steps": [
        {
          "after": [],
          "minutes": 3,
          "passive": false,
          "text": "Skölj riset i sil. Lägg det i en kastrull med risets salt och 560 ml vatten; koka upp och sänk till låg värme.",
          "uses": [
            "ris",
            "salt"
          ]
        },
        {
          "after": [
            1
          ],
          "minutes": 18,
          "passive": true,
          "text": "Sjud riset under lock cirka 18 minuter tills vattnet absorberats. Följ förpackningens koktid och förläng vid behov.",
          "uses": [
            "ris"
          ]
        },
        {
          "after": [
            2
          ],
          "minutes": 1,
          "text": "Kontrollera att riset är mjukt, stäng av värmen och lägg på locket.",
          "uses": [
            "ris"
          ]
        },
        {
          "after": [
            3
          ],
          "minutes": 5,
          "passive": true,
          "text": "Låt riset vila under lock i fem minuter.",
          "uses": [
            "ris"
          ]
        },
        {
          "after": [
            4
          ],
          "minutes": 1,
          "passive": false,
          "text": "Luckra upp riset och håll det varmt över 60 °C under lock tills huvudrätten serveras.",
          "uses": [
            "ris"
          ]
        },
        {
          "after": [
            5
          ],
          "minutes": 12,
          "passive": false,
          "text": "Skala och väg schalottenlöken, dela den och rosta i torr panna tills mjuk med mörka fläckar. Färsk vitlök kan rostas med löken; fryst hackad vitlök läggs direkt i mixern med all sin vätska. Mixa löken, vitlöken och chiliflakes med 100 ml vatten till grov pasta.",
          "uses": [
            "schalottenlök",
            "vitlök",
            "chiliflakes"
          ]
        },
        {
          "after": [
            6
          ],
          "minutes": 10,
          "passive": false,
          "text": "Väg rå ätlig tomat och tärna. Värm oljan och fräs kryddpastan ett par minuter. Tillsätt färsen och finfördela, rör ner tomater och hela fisksåsmängden. Behåll allt fett och köttsaft.",
          "uses": [
            "tomat",
            "rapsolja",
            "fisksås",
            "fläskfärs"
          ]
        },
        {
          "after": [
            7
          ],
          "minutes": 10,
          "passive": true,
          "text": "Låt dippen sjuda utan lock på låg värme i tio minuter.",
          "uses": [
            "fläskfärs",
            "tomat"
          ]
        },
        {
          "after": [
            8
          ],
          "minutes": 1,
          "text": "Rör från botten och kontrollera att inget bränner fast. Justera värmen.",
          "uses": [
            "fläskfärs",
            "tomat"
          ]
        },
        {
          "after": [
            9
          ],
          "minutes": 10,
          "passive": true,
          "text": "Sjud ytterligare tio minuter utan lock.",
          "uses": [
            "fläskfärs",
            "tomat"
          ]
        },
        {
          "after": [
            10
          ],
          "minutes": 5,
          "text": "Rör om och kontrollera minst 72 °C i färsen. Reducera under omrörning tills dippen är tjock nog att ligga kvar på en grönsaksbit; räkna med fem minuter och förläng vid behov. Behåll hela dippen.",
          "uses": [
            "fläskfärs",
            "tomat"
          ]
        },
        {
          "after": [
            11
          ],
          "minutes": 7,
          "passive": false,
          "text": "Skär gurkan i breda stavar. Servera den varma dippen i en skål per portion med grönsaker och ris runt om. Grönsakerna vägs ansade som rå ätlig mängd. Behåll all eventuell limedressing.",
          "uses": [
            "gurka",
            "fläskfärs",
            "ris"
          ]
        }
      ],
      "variant_id": "simple",
      "version": "1.0.1"
    },
