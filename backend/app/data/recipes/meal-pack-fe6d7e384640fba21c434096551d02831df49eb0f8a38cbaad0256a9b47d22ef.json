        "side": "potatis i pastan",
        "steps": [
          {
            "depends_on": [],
            "duration_minutes": 10,
            "id": "s1",
            "ingredient_keys": [
              "gul lök|raw_edible",
              "mozzarella|preserved_drained",
              "potatis|raw_edible"
            ],
            "parallel_group": null,
            "text": "Skala potatisen, väg den råa ätliga mängden och skär i tärningar på cirka 1 cm. Hacka löken och låt mozzarellan rinna av utan att pressa, väg utan fri lag och tärna."
          },
          {
            "depends_on": [
              "s1"
            ],
            "duration_minutes": 6,
            "id": "s2",
            "ingredient_keys": [
              "gul lök|raw_edible",
              "olivolja|as_sold",
              "tomatpuré|as_sold"
            ],
            "parallel_group": null,
            "text": "Värm oljan i grytan och mjukstek löken fem minuter. Rör ner tomatpurén och fräs en minut."
          },
          {
            "depends_on": [
              "s2"
            ],
            "duration_minutes": 3,
            "id": "s3",
            "ingredient_keys": [
              "potatis|raw_edible",
